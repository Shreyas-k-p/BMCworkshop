{
  "rules": {
    "connectionTests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "!data.exists() ? auth != null : data.child('hostUid').val() === auth.uid"
      }
    },
    "sessionCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "participants": {
      "$sessionId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && ($uid === auth.uid || root.child('sessions').child($sessionId).child('hostUid').val() === auth.uid)"
        }
      }
    },
    "groups": {
      "$sessionId": {
        ".read": "auth != null",
        "$groupId": {
          ".read": "auth != null && (root.child('sessions').child($sessionId).child('hostUid').val() === auth.uid || root.child('participants').child($sessionId).child(auth.uid).child('groupId').val() === $groupId)",
          ".write": "auth != null && root.child('sessions').child($sessionId).child('hostUid').val() === auth.uid"
        }
      }
    },
    "scores": {
      "$sessionId": {
        "$presentingGroupId": {
          "$evaluatorUid": {
            ".read": "auth != null",
            ".write": "auth != null && ((!data.exists() && $evaluatorUid === auth.uid && root.child('participants').child($sessionId).child(auth.uid).child('isCaptain').val() === true && root.child('participants').child($sessionId).child(auth.uid).child('groupId').val() !== $presentingGroupId && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 10) || root.child('sessions').child($sessionId).child('hostUid').val() === auth.uid)"
          }
        }
      }
    },
    "lobbyMessages": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
